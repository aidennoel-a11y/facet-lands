{
  "name": "lowpoly-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs');fs.rmSync('server/game',{recursive:true,force:true});fs.cpSync('dist','server/game',{recursive:true})\"",
    "preview": "vite preview",
    "map": "node tools/map.mjs",
    "water": "node tools/water.mjs",
    "shot": "node tools/shot.mjs",
    "sound": "node tools/sound.mjs",
    "pack": "npm run build && python3 tools/pack-artifact.py"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  }
}
